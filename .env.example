# Copy to .env and fill in real values.
# .env is git-ignored.

# --- Core ---
# --- Core ---
# Generate a real SECRET_KEY for production with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The fallback below is dev-only and Django will refuse to start in
# production (DEBUG!=true) if SECRET_KEY is unset.
SECRET_KEY=dev-only-not-for-production-CHANGE-ME-please-50chars
DEBUG=true
TIME_ZONE=Europe/London
MAIN_HOST=http://localhost
HOSTS=http://localhost,http://127.0.0.1
# No ALLOW_ALL_HOSTS - that escape hatch has been removed for security.
# In production set HOSTS to the comma-separated list of public origins.

# --- Postgres ---
POSTGRES_DB=workoutchallenge
POSTGRES_USER=postgres
# A strong random password is required. The docker-compose stack now
# refuses to start with the previous "password" default.
POSTGRES_PASSWORD=
# Optional host-side psql access (the app itself uses the internal
# network and never needs this). Localhost-only by default; set
# POSTGRES_BIND=0.0.0.0 only behind a firewall, and pick a different
# POSTGRES_HOST_PORT if the host already runs a Postgres on 5432.
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
# Bind address for the debug/monitoring ports (5555 Flower, 8000 gunicorn,
# 9001 supervisord). They have no built-in auth - keep this at 127.0.0.1
# on any untrusted/public host and use SSH port forwarding instead.
DEBUG_BIND=127.0.0.1
# Public app port (nginx serves frontend + /api on container port 80 -
# only the host side changes). Behind a reverse proxy on the same host:
# APP_BIND=127.0.0.1 and APP_PORT=<the port your proxy forwards to>.
APP_BIND=0.0.0.0
APP_PORT=80

# --- Strava (leave blank to disable) ---
# Get from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=000000
STRAVA_CLIENT_SECRET=
STRAVA_LIMIT_15MIN=100
STRAVA_LIMIT_DAY=1000

# --- Garmin (optional) ---
# Explicit key for encrypting stored Garmin OAuth tokens at rest.
# Falls back to a key derived from SECRET_KEY when blank - set this if
# you rotate SECRET_KEY and want existing Garmin linkages to survive.
GARMIN_TOKEN_KEY=

# --- Email (leave blank to disable) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=workout@localhost
EMAIL_REPLY_TO=

# --- LLM / AI provider ---
# Pick ONE of these patterns:
#   OpenAI:        just set OPENAI_API_KEY
#   MiniMax:       set OPENAI_API_KEY + LLM_PROVIDER=MiniMax
#   OpenRouter:    set OPENAI_API_KEY + LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama local:  set OPENAI_API_KEY=ollama + LLM_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_EMAIL_MODEL=gpt-4o

# --- Sentry (optional) ---
SENTRY_DSN=

# --- VAPID push (auto-generated if blank) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
# Optional: require this invite token for new registrations.
# If empty, registration is open to everyone. Do NOT commit the real token.
REGISTRATION_TOKEN=
# Days a login stays valid WITHOUT opening the app (rolling window -
# every app use re-extends it, so active users never log in again).
JWT_REFRESH_DAYS=31
