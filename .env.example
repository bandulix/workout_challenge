# Copy to .env and fill in real values.
# .env is git-ignored.

# --- Core ---
# SECRET_KEY is REQUIRED (docker-compose refuses to start without it).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# DEBUG defaults to false in docker-compose - opt in explicitly for dev.
DEBUG=false
# Release version for the "What's new" popup. The CI-built image bakes
# this in from the git tag - only set it for custom/local builds
# ("dev" disables the popup).
# APP_VERSION=dev
TIME_ZONE=Europe/London
MAIN_HOST=http://localhost
HOSTS=http://localhost,http://127.0.0.1
# No ALLOW_ALL_HOSTS - that escape hatch has been removed for security.
# In production set HOSTS to the comma-separated list of public origins.
# MAIN_HOST is also the server address baked into the Android APK by
# scripts/build_apk.sh - and when you build the app, HOSTS must include
# its origin https://localhost (Capacitor WebView) for CORS.

# --- Postgres ---
POSTGRES_DB=workoutchallenge
POSTGRES_USER=postgres
# A strong random password is required. The docker-compose stack now
# refuses to start with the previous "password" default.
POSTGRES_PASSWORD=
# Postgres is not exposed to the host at all - the app reaches it over the
# internal compose network. For manual psql access use:
#   docker compose exec database psql -U postgres workoutchallenge
# Bind address for the Flower monitoring port (5555). Flower requires
# basic auth (below), but still keep this at 127.0.0.1 on any
# untrusted/public host and use SSH port forwarding instead.
# (gunicorn :8000 and the supervisord UI :9001 are no longer published -
#  they bind loopback inside the container.)
DEBUG_BIND=127.0.0.1
# Basic auth for the Flower task-monitoring UI on :5555.
# FLOWER_PASSWORD is REQUIRED and MUST differ from SECRET_KEY - Django
# refuses to start in production if they match (issue #23).
FLOWER_USER=admin
FLOWER_PASSWORD=
# Public app port (nginx serves frontend + /api on container port 80 -
# only the host side changes). Default is loopback: put a TLS-terminating
# reverse proxy in front (APP_BIND=127.0.0.1, APP_PORT=<proxy upstream>).
# Set APP_BIND=0.0.0.0 only on a trusted LAN. If that proxy uses nginx
# limit_req, allow ~25 r/s burst 80 (5 r/s burst 20 is enough for
# CrowdSec nginx-req-limit-exceeded to ban users).
APP_BIND=127.0.0.1
APP_PORT=80

# --- Strava (leave blank to disable) ---
# Get from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=000000
STRAVA_CLIENT_SECRET=
STRAVA_LIMIT_15MIN=100
STRAVA_LIMIT_DAY=1000

# --- Garmin (optional) ---
# Explicit key for encrypting stored Garmin OAuth tokens at rest.
# Falls back to a key derived from SECRET_KEY when blank - set this if
# you rotate SECRET_KEY and want existing Garmin linkages to survive.
GARMIN_TOKEN_KEY=

# --- Health: Apple Health / Health Connect via Open Wearables (optional) ---
# Apple Health and Google Health Connect have no cloud API - the workouts
# only exist on the phone. This compose file therefore bundles a full
# Open Wearables instance (MIT, https://github.com/the-momentum/
# open-wearables) as an OPT-IN profile; the athlete's health app pushes
# the on-device data there and this app polls it.
#
# Setup:
#   1. Set OW_POSTGRES_PASSWORD below.
#   2. Start everything including the health services:
#        docker compose --profile health up -d
#      (first start builds the Open Wearables image from a pinned
#      upstream commit - takes a few minutes)
#   3. Done - the Health section appears in the personal settings.
#      (The connector logs into OW with the seeded admin developer -
#      OW_ADMIN_* below - so no API-key minting step is needed.)
#
# Server-side API address the workout app calls (internal by default):
HEALTH_BASE_URL=http://openwearables:8000
# The address shown to PHONES in the connection code - they must reach
# it! Default: MAIN_HOST + /health - the app's nginx proxies /health/ to
# the Open Wearables container, so phones just use the app's own public
# HTTPS address (never the internal docker hostname: that is the classic
# "host not found" in the app). Set this only if you expose OW elsewhere
# (e.g. https://health.your-domain.com via your own reverse proxy).
HEALTH_PUBLIC_URL=
# Developer login the connector uses (defaults to the seeded OW admin;
# runtime-editable in Site Settings, DB wins). Must differ from SECRET_KEY.
# HEALTH_DEVELOPER_EMAIL=admin@example.com
# HEALTH_DEVELOPER_PASSWORD=     (defaults to OW_ADMIN_PASSWORD)
# Open Wearables service knobs:
OW_POSTGRES_PASSWORD=
# OW_ADMIN_EMAIL=admin@example.com
# OW_ADMIN_PASSWORD is REQUIRED when using --profile health and MUST
# differ from SECRET_KEY (never reuse Django's secret as the OW password).
OW_ADMIN_PASSWORD=
# OW_BIND=127.0.0.1             (keep loopback; 0.0.0.0 exposes the API to the LAN)
# OW_PORT=8001
# OW_CORS_ORIGINS='["https://localhost"]'   (JSON list, NOT a bare string - extra
#                                            browser origins the OW API allows;
#                                            the Android app's WebView origin is
#                                            already the default)

# --- Email (leave blank to disable) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=workout@localhost
EMAIL_REPLY_TO=

# --- LLM / AI provider ---
# Pick ONE of these patterns:
#   OpenAI:        just set OPENAI_API_KEY
#   MiniMax:       set OPENAI_API_KEY + LLM_PROVIDER=MiniMax
#   OpenRouter:    set OPENAI_API_KEY + LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama local:  set OPENAI_API_KEY=ollama + LLM_BASE_URL=http://host.docker.internal:11434/v1
#   OpenCode Zen:  OPENAI_API_KEY=<zen key> + LLM_BASE_URL=https://opencode.ai/zen/v1
#                  + LLM_MODEL=gemini-3.5-flash-lite (multimodal - the photo
#                  feature's vision probe passes on it; the camera button then
#                  appears automatically. Zen's Gemini models officially use a
#                  Google-native endpoint - if the probe fails, pick one of
#                  Zen's /chat/completions models instead, e.g. minimax-m3.)
OPENAI_API_KEY=
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_EMAIL_MODEL=gpt-4o
# Coach feed photo posts: max pictures per user per day (each one queues
# an AI reaction - and an image-edit roast when the provider supports it).
DRILL_MAX_PHOTOS_PER_DAY=2
# Optional: separate OpenAI-compatible endpoint for IMAGE EDITING (the
# coach's roasted-photo remix). Chat models that read images often can't
# create them (e.g. MiniMax M3, Gemini Flash Lite) - point this at a
# provider with an OpenAI-style images/edit endpoint to get the roast
# while chat/vision stay on your main provider. All three together, or
# none. LLM_IMAGE_API_KEY falls back to OPENAI_API_KEY when blank.
# NOTE: OpenCode Zen does NOT work here - it has no images/edit endpoint
# (its Gemini image models speak Google's generateContent API, which this
# app doesn't use). Two verified setups:
#   OpenAI:    LLM_IMAGE_BASE_URL=https://api.openai.com/v1
#              LLM_IMAGE_MODEL=gpt-image-1
#   Grok (xAI): LLM_IMAGE_BASE_URL=https://api.x.ai/v1
#              LLM_IMAGE_MODEL=grok-imagine-image   (or ...-quality)
#              xAI's JSON wire format on /images/edits is handled
#              automatically - detected from the api.x.ai host.
# LLM_IMAGE_BASE_URL=
# LLM_IMAGE_MODEL=
# LLM_IMAGE_API_KEY=

# --- Sentry (optional) ---
SENTRY_DSN=

# --- VAPID push (auto-generated if blank) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional: require this invite token for new registrations.
# If empty, registration is open to everyone. Do NOT commit the real token.
REGISTRATION_TOKEN=
# Days a login stays valid WITHOUT opening the app (rolling window -
# every app use re-extends it, so active users never log in again).
JWT_REFRESH_DAYS=31

# Pre-built image note: `docker compose up -d` pulls ghcr.io/bandulix/workout_challenge
# (see docker-compose.yml); no local build required.
